{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lifeplan-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "vars": {
    "AUTH_EMAIL_FROM": "noreply@mail.nmtng.com",
    "MOBILE_SCHEME": "lifeplan://"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lifeplan-app",
      "database_id": "3d7e5e58-dc82-4d3a-b0d8-ffeb52fd5faf"
    }
  ]
}
